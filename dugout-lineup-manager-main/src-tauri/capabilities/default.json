{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions needed for desktop updates",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/backend-sidecar",
          "sidecar": true
        }
      ]
    },
    "dialog:default",
    "updater:default",
    "process:allow-restart",
    "core:window:allow-start-dragging"
  ]
}
